DATABASE_URL=postgres://replay:replay@localhost:5432/replay?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
DB_MAX_CONNS=10
MAX_BODY_BYTES=1048576
ORDERING_POLICY=BUFFER
IDEMPOTENCY_TTL=24h
PENDING_GAP_TTL=1h
LEASE_TTL=30s
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_BACKOFF=25ms
RETRY_MAX_BACKOFF=500ms
